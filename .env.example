SMTP_PORT=587
SMTP_USERNAME=twoj-email@gmail.com
SMTP_PASSWORD=haslo-aplikacji-smtp
SMTP_FROM=twoj-email@gmail.com

# Zalecane na Renderze: wysyłka e-mail przez API Resend (HTTPS)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Glovaro <onboarding@resend.dev>

# Płatności online Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Dane firmy do regulaminu i polityki prywatności

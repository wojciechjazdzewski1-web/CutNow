# Lokalnie: skopiuj do .env i uzupełnij (plik .env nie trafia na GitHub)
# Na Renderze ustaw DATABASE_URL (PostgreSQL) — inaczej dane znikają po każdym deploy!
# DATABASE_URL=postgresql://...
# DATA_DIR=/var/data
SECRET_KEY=twoj-losowy-klucz-min-32-znaki
PANEL_PASSWORD=twoje-haslo-do-panelu
FLASK_DEBUG=true
REMINDER_SECRET=losowy-tajny-klucz-do-cron

# Powiadomienia e-mail po nowej rezerwacji (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=twoj-email@gmail.com
SMTP_PASSWORD=haslo-aplikacji-smtp
SMTP_FROM=twoj-email@gmail.com

# Zalecane na Renderze: wysyłka e-mail przez API Resend (HTTPS) — SMTP na Renderze często nie działa
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# WAŻNE: onboarding@resend.dev wysyła TYLKO na e-mail właściciela konta Resend (tryb testowy).
# Produkcja: zweryfikuj domenę w https://resend.com/domains i ustaw np.:
# RESEND_FROM=Glovaro <powiadomienia@glovaro.pl>
RESEND_FROM=Glovaro <onboarding@resend.dev>

# Automatyczne przypomnienia mailowe:
# ustaw zewnętrzny cron (np. Render Cron Job / cron-job.org) na adres:
# https://twojadomena.pl/tasks/send-reminders?secret=REMINDER_SECRET
# najlepiej co 30-60 minut. Cleanup archiwum:
# https://twojadomena.pl/tasks/cleanup-reservations?secret=REMINDER_SECRET

# Płatności online Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Dane operatora — WYMAGANE na produkcji (regulamin, RODO, reklamacje)
# Przy działalności nierejestrowanej podaj imię i nazwisko / nazwę publiczną, adres do korespondencji i e-mail.
# NIP jest opcjonalny: jeśli go nie ustawisz, nie będzie pokazywany w dokumentach prawnych.
LEGAL_COMPANY_NAME=Imię i nazwisko / Glovaro
LEGAL_COMPANY_ADDRESS=Ulica 1, 00-000 Miasto
LEGAL_COMPANY_EMAIL=kontakt@twojadomena.pl
LEGAL_COMPANY_NIP=
LEGAL_UNREGISTERED_ACTIVITY=true
